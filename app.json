{
  "expo": {
    "name": "Tréville",
    "slug": "treville-nfc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "treville",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nfcmanager.app",
      "backgroundColor": "#F8FAFF",
      "infoPlist": {
        "NFCReaderUsageDescription": "O Tréville usa o NFC para ler, gravar e apagar tags."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF"
        ]
      }
    },
    "android": {
      "package": "com.tagsluiz.nfcmanager",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#F8FAFF"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/treville-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0A0F1E",
            "image": "./assets/brand/treville-logo.png"
          },
          "android": {
            "backgroundColor": "#F3F3F3",
            "image": "./assets/brand/treville-logo.png",
            "imageWidth": 200,
            "dark": {
              "backgroundColor": "#F3F3F3",
              "image": "./assets/brand/treville-logo.png"
            }
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "react-native-nfc-manager",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81a1f769-7602-4403-b4e2-6d6776ba6339"
      }
    }
  }
}
