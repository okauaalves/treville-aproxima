{
  "expo": {
    "name": "Tréville Aproxima",
    "slug": "nfc-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "treville",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF2FF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.treville.aproxima",
      "backgroundColor": "#EEF2FF",
      "infoPlist": {
        "NFCReaderUsageDescription": "Usado para ler e gravar tags NFC."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF"
        ]
      }
    },
    "android": {
      "package": "com.treville.aproxima",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#EEF2FF",
      "name": "Tréville Aproxima",
      "shortName": "Tréville"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF2FF",
          "image": "./assets/brand/treville-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/brand/treville-logo.png"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "react-native-nfc-manager",
      "./plugins/withNfcTechFilter",
      "./plugins/withTaskerQueries",
      "expo-web-browser",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81a1f769-7602-4403-b4e2-6d6776ba6339"
      }
    }
  }
}
