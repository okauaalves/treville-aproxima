{
  "expo": {
    "name": "Tréville Aproxima",
    "slug": "nfc-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "treville",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF2FF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.treville.aproxima",
      "backgroundColor": "#EEF2FF",
      "infoPlist": {
        "NFCReaderUsageDescription": "Usado para ler e gravar tags NFC.",
        "NSCameraUsageDescription": "Usado para escanear o QR Code da plaquinha."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF",
          "NDEF"
        ]
      }
    },
    "android": {
      "package": "com.treville.aproxima",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.NFC",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#EEF2FF",
      "name": "Tréville Aproxima",
      "shortName": "Tréville"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF2FF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "react-native-nfc-manager",
      "./plugins/withNfcTechFilter",
      "./plugins/withTaskerQueries",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Usado para escanear o QR Code da plaquinha.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ac2fd1d-720e-4220-adb4-ea24b766f4ee"
      }
    },
    "owner": "trevilleaproxima",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9ac2fd1d-720e-4220-adb4-ea24b766f4ee"
    }
  }
}
