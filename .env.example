# Copie para .env e preencha com a URL e a anon key do projeto.
# A service_role key NUNCA vai aqui; ela fica apenas nos secrets das Edge Functions do Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID (opcional, não usado pelo fluxo do Supabase)
# Domínio do link curto /t/<ID> (opcional; padrão https://nfc-manager.expo.app)
# EXPO_PUBLIC_SHORT_LINK_BASE=
# Link do APK de produção (opcional; sobrescreve LATEST_APK_URL em constants/config.ts).
# Atualize após: eas build --platform android --profile production
# EXPO_PUBLIC_APK_URL=
# Página pública /p/<ID> (opcional; padrão EXPO_PUBLIC_SHORT_LINK_BASE + /p)
# EXPO_PUBLIC_PROFILE_PAGE_URL=
# Só no servidor (EAS Hosting, `eas env:create`) e igual ao secret da função redirect:
# SHORT_LINK_PROXY_SECRET=
#
# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs (adicione ambos):
#   treville://auth/callback
#   https://nfc-manager.expo.app/auth/open

